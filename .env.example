# cc-studio secrets. Copy to .env (npm run setup does it for you). Never commit .env.

# Telegram approvals and alerts: make a bot with @BotFather, send it any message, then
# `npm run setup` finds your chat id. Use a bot only cc-studio polls.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ElevenLabs voiceover, music and sound effects for the creator (tools/eleven.py).
ELEVENLABS_API_KEY=

# Free stock footage the creator checks before generating a scene (scripts/clips.mjs).
# Free keys: pexels.com/api and pixabay.com/api/docs. Without them only your library is searched.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Optional: Instagram Graph API accounts ("platform": "instagram-api"), one pair per account,
# the account id upper-cased with dashes as underscores. See docs/instagram-api-setup.md.
# IG_TOKEN_MYBRAND_INSTAGRAM=
# IG_USER_MYBRAND_INSTAGRAM=
